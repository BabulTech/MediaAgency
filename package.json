{
  "name": "mamp",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @mamp/api\" \"npm run dev -w @mamp/web\"",
    "build": "npm run build -w @mamp/web",
    "test": "npm test -w @mamp/pricing && npm test -w @mamp/api",
    "db:generate": "npm run db:generate -w @mamp/api"
  },
  "devDependencies": { "concurrently": "^9.0.0", "typescript": "^5.6.0", "vitest": "^3.0.0" }
}
